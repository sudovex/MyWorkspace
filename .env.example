# ---------------------------------------------------------------------------
# WorkspaceOS environment
# Copy to `.env.local`. All values are OPTIONAL at M0 — the app builds and runs
# without them. They become required only when the features that use them ship
# (Contact form + `sudo hire shubham` in M6).
# ---------------------------------------------------------------------------

# Public site URL (used for metadata / canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — contact form, recruiter workflow, optional analytics
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — outbound notification email for `sudo hire shubham`
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=
